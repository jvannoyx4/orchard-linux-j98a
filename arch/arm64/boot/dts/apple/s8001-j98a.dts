/dts-v1/;

#include "s8001-pro.dtsi"
#include "s8001-j98a-j99a.dtsi"

/ {
	compatible = "apple,j98a", "apple,s8001", "apple,arm-platform";
	model = "Apple iPad Pro (12.9-inch) (Wi-Fi)";

	aliases {
		serial5 = &serial5;
	};
};

&pinctrl_ap {
	battery_swi_pins: battery-swi-pins {
		pinmux = <APPLE_PINMUX(130, 1)>;
	};
};

&serial5 {
	pinctrl-names = "default";
	pinctrl-0 = <&battery_swi_pins>;
	status = "okay";

	onewire {
		compatible = "ti,hdq-uart";

		fuel-gauge {
			compatible = "ti,bq27540-hdq";
		};
	};
};

&{/soc} {
	/* The three populated PCIe ports each have their own DART. */
	pcie0_dart0: iommu@601008000 {
		compatible = "apple,s8001-dart", "apple,s5l8960x-dart";
		reg = <0x6 0x01008000 0x0 0x4000>;
		#iommu-cells = <5>;
		interrupts = <AIC_IRQ 271 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_pcie_link0>;
		apple,error-reflector = /bits/ 64 <0x20fffc000>;
		apple,fetch-config = <0x000e0303>;
		apple,diag-config = <0x00000100>;
		status = "disabled";
	};

	pcie0_dart2: iommu@603008000 {
		compatible = "apple,s8001-dart", "apple,s5l8960x-dart";
		reg = <0x6 0x03008000 0x0 0x4000>;
		#iommu-cells = <5>;
		interrupts = <AIC_IRQ 277 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_pcie_link2>;
		apple,error-reflector = /bits/ 64 <0x20fffc000>;
		apple,fetch-config = <0x000e0303>;
		apple,diag-config = <0x00000100>;
		status = "disabled";
	};

	pcie0_dart4: iommu@605008000 {
		compatible = "apple,s8001-dart", "apple,s5l8960x-dart";
		reg = <0x6 0x05008000 0x0 0x4000>;
		#iommu-cells = <5>;
		interrupts = <AIC_IRQ 283 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_pcie_link4>;
		apple,error-reflector = /bits/ 64 <0x20fffc000>;
		apple,fetch-config = <0x000e0303>;
		apple,diag-config = <0x00000100>;
		status = "disabled";
	};
};
